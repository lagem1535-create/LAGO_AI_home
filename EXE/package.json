{
  "name": "lago-desktop",
  "productName": "LAGO",
  "version": "0.2.2",
  "description": "LAGO AI Desktop - 작업 폴더 · 터미널 · 코드 저장이 되는 Windows · macOS 앱",
  "main": "main.js",
  "author": "LAGO AI",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable --publish never",
    "dist:mac": "electron-builder --mac dmg --x64 --arm64 --publish never"
  },
  "devDependencies": {
    "electron": "43.8.3",
    "electron-builder": "26.17.0"
  },
  "build": {
    "appId": "ai.lago.desktop",
    "productName": "LAGO",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "offline.html",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "LAGO",
      "artifactName": "LAGO-Setup.exe",
      "deleteAppDataOnUninstall": true
    },
    "portable": {
      "artifactName": "LAGO-Portable.exe"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.developer-tools",
      "artifactName": "LAGO-Mac-${arch}.${ext}",
      "identity": "-"
    },
    "dmg": {
      "title": "LAGO"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lagem1535-create/LAGO_AI_home.git"
  }
}